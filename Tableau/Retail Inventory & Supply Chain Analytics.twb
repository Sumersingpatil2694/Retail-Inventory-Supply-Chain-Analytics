        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [delivery_delay_days] &lt;= 2 THEN 1&#13;&#10;    ELSE 0&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([delivery_delay_days])&#13;&#10;* 100' />
      </column>
      <column caption='Latest Date per Product' datatype='date' name='[Calculation_0842262405111808]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [product_id], [store_id] : MAX([date]) }' />
      </column>
      <column caption='Is Latest Product Record' datatype='boolean' name='[Calculation_0842262405971969]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[date] = [Calculation_0842262405111808]' />
      </column>
      <column caption='Total Stock On Hand (Lakh)' datatype='real' name='[Calculation_0842262418857986]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ROUND(SUM([inventory_level]) / 100000, 2)' />
      </column>
      <column caption='Inventory Value' datatype='real' name='[Calculation_1119338408796162]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[inventory_level] * [unit_price_txn]' />
      </column>
      <column caption='Latest Inventory Level' datatype='integer' name='[Calculation_1119338412986371]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [date] = { FIXED : MAX([date]) }&#13;&#10;THEN [inventory_level]&#13;&#10;END' />
      </column>
